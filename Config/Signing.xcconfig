// App name and signing settings.

// The name under the icon, on widgets and on the watch. Change it here only.
APP_DISPLAY_NAME = Inkstone
//
// Apple needs every app on a phone to have its own ID. If Xcode says the ID is
// already taken, change the last word below to anything else (letters and
// numbers only), for example app.inkstone.maria2026, and build again.
INKSTONE_BUNDLE_PREFIX = app.inkstone.hanzi7q4k

// The shared folder the app and its widgets both read (the watch has its own copy).
// It does not need to match the line above. If you change it, change it in all four
// .entitlements files in this folder too.
INKSTONE_APP_GROUP = group.app.inkstone.hanzi7q4k
